# Environment Configuration for ResearchPilot

# LLM Provider Configuration (groq, ollama, openai)
LLM_PROVIDER=groq

# Groq API Configuration (Free high-speed cloud tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama Configuration (Local, free, 100% private)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b

# OpenAI Configuration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Retrieval Settings
CHROMA_PERSIST_DIR=./backend/chroma_db
RETRIEVAL_TOP_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MAX_REVISION_ATTEMPTS=2
